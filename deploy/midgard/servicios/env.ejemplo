# Claves de /srv/apps/ves-market/.env (root, 600). Aquí solo los NOMBRES: los
# valores no salen de la máquina ni entran en el repositorio.

# Etiqueta de las cinco imágenes propias. `traslado-20261013` mientras sean las
# copiadas de desarrollo; `sha-xxxxxxx` cuando las publique el CI.
IMAGE_TAG=

# Las mismas dos que /srv/apps/ves-api-gateway/.env.
DATABASE_URL=
AMQP_URL=

# La misma que /srv/infra/ves-market/.env. La usa el respaldo para pg_dump.
POSTGRES_PASSWORD=

# Pseudónimo de comerciantes (ADR-0011). NO se rota: parte la serie histórica.
MERCHANT_HMAC_KEY=

# Autoriza a servir el túnel de Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# Respaldo a Backblaze B2 (ADR-0027). Ver scripts/respaldo/README.md.
RCLONE_REMOTE=
RCLONE_CONFIG_PASS=

# Tema de ntfy para los avisos del respaldo. El tema ES la credencial.
AVISO_URL=

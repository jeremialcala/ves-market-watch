# Claves de /srv/apps/ves-respaldo/.env (root:deploy, 640). Aqui solo los NOMBRES: los
# valores no salen de la maquina ni entran en el repositorio.
#
# IMAGE_TAG no va aqui: lo inyecta el receptor en cada despliegue.

# La misma que /srv/infra/ves-market/.env. La usa pg_dump.
POSTGRES_PASSWORD=

# Respaldo a Backblaze B2 (ADR-0027). Ver scripts/respaldo/README.md.
RCLONE_REMOTE=
RCLONE_CONFIG_PASS=

# Tema de ntfy para los avisos. El tema ES la credencial.
AVISO_URL=

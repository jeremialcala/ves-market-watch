# Claves de /srv/apps/ves-ingestor-binance/.env (root:deploy, 640). Aqui solo los NOMBRES: los
# valores no salen de la maquina ni entran en el repositorio.
#
# IMAGE_TAG no va aqui: lo inyecta el receptor en cada despliegue.

# Las mismas dos que /srv/apps/ves-api-gateway/.env.
DATABASE_URL=
AMQP_URL=

# Pseudonimo de comerciantes (ADR-0011). NO se rota: parte la serie historica.
MERCHANT_HMAC_KEY=

{
  "name": "portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Portal público de Criterio: landing, Dashboard sin cuenta, APIs, Precios y Estado (ADR-0031).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "generate:api": "openapi-typescript ../api-gateway/docs/portal-openapi.yaml -o src/api/portal.gen.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "test": "npm run check:api-types && vitest run --coverage"
  },
  "dependencies": {
    "@criterio/ui": "*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "typescript": "~5.9.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.12"
  }
}
